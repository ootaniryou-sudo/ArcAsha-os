# ArcAsha 環境設定（例）
# このファイルを .env にコピーして、実際の値を設定してください。
#   cp .env.example .env
# .env は .gitignore に含まれるため、コミットされません。

# ── 外部 API（OpenAI 互換 /v1/chat/completions）──────────────────────
# DeepSeek: https://api.deepseek.com
# OpenAI  : https://api.openai.com
# Ollama  : http://localhost:11434/v1 （キー不要）
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI 互換 API（任意）
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

# 起動時に自動接続する外部 API（空なら自動接続しない）
# 例: ARCASHA_AUTO_API="deepseek"
ARCASHA_AUTO_API=

# ── データ保存先（記憶・フィードバック・チャットログ・監査・設定）──────────────
# 既定は ~/.arcasha/（ユーザーホーム直下・リポジトリ外 = git に含まれない）。
# ここで保存先ディレクトリを変更できます。すべてリポジトリ外に置くこと
# （API キーや会話ログが git に含まれないようにするため）。
#
# 長期記憶（スレッド・facts・knowledge）: assistant-memory.json
ARCASHA_MEMORY_DIR=~/.arcasha
# フィードバック（👍/👎 + 理由）: assistant-feedback.jsonl
ARCASHA_FEEDBACK_DIR=~/.arcasha
# チャット記録（会話ログ・時系列）: chat-log.jsonl
ARCASHA_CHAT_LOG_DIR=~/.arcasha
# 監査ログ（署名付き証跡・HMAC 鍵）: agent-audit/
ARCASHA_AUDIT_DIR=~/.arcasha/agent-audit
# 監査ログの HMAC 署名鍵（省略時は一時生成 = 再起動で検証不可）
ARCASHA_AUDIT_SECRET=

# ── Assistant サーバ（WebUI / チャット）──────────────────────────────
# WebUI・API のポート（既定 4781）
ARCASHA_ASSISTANT_PORT=4781
# Coding Agent（実ファイル編集）の作業ディレクトリ（設定タブで上書き可）
ARCASHA_WORKDIR=
# 任意コマンド実行を許可（1 で有効。危険なため opt-in）
ARCASHA_AGENT_ALLOW_RUN=0
# 安全モード: 実ワークスペース編集を作業ブランチに隔離（1 で有効）
ARCASHA_AGENT_SAFE_MODE=0

